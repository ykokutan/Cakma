# Dependencies
node_modules/
*/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment variables
.env
.env.local
.env.*.local

# OS / Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Rust / Tauri build artifacts (if building desktop client)
client/src-tauri/target/

# Persistent Application Databases (Users, servers, channels, messages, licenses)
data/
server/data/
*/data/
*.tmp-*

# Build outputs (automatically rebuilt by start.sh / update.sh)
client/dist/
server/dist/
dedicated-server/dist/

# Never put installers inside client/public (prevents recursive Tauri bundling)
client/public/downloads/
bin/

# Playwright E2E
playwright-report/
test-results/
blob-report/

