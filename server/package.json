{
  "name": "discord-clone-server",
  "version": "1.6.0",
  "description": "Discord / TeamSpeak Clone Backend with Real-Time WebSockets & WebRTC Signaling",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint --config ../eslint.config.mjs src",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.20.0",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
